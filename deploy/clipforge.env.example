# Kopieren nach deploy/clipforge.env und ausfüllen. NIE ins Repository einchecken.
# Server-Schlüssel (mind. 32 Zeichen) für Verschlüsselung der API-Schlüssel:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CLIPFORGE_SECRET_KEY=
# Öffentliche Adresse, unter der ClipForge erreichbar ist (für die Herkunftsprüfung):
CLIPFORGE_ALLOWED_ORIGINS=https://clipforge.example.com
# Erstes Konto (nur für den ersten Start, danach entfernen):
CLIPFORGE_ADMIN_USER=
CLIPFORGE_ADMIN_PASSWORD=
# Nur setzen, wenn ClipForge NICHT hinter HTTPS läuft (z. B. reiner Test im LAN):
# CLIPFORGE_COOKIE_SECURE=0
