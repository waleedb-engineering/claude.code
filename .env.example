# ClipForge — Backend-Konfiguration (lokal).
#
# Kopiere diese Datei zu `.env` (macht `setup_local.sh` automatisch, ohne eine
# bestehende `.env` zu überschreiben). `start_local.sh` liest `.env`, falls
# vorhanden, und exportiert die Variablen vor dem Start von uvicorn.
#
# WICHTIG: Diese Datei enthält KEINE echten Werte/Secrets — nur sichere
# Defaults bzw. auskommentierte Beispiele. Alle Zeilen sind optional; ohne
# `.env` verwendet ClipForge exakt dieselben Defaults.

# --- Core --------------------------------------------------------------------
# ANTHROPIC_API_KEY: nur nötig für den KI-Analyzer-Modus (sonst regelbasiert).
# ANTHROPIC_API_KEY=

# --- Jobs ----------------------------------------------------------------------
# Speicherort für Job-Daten (Uploads, Clips, Exporte). Default: api/jobs
# CLIPFORGE_JOBS_DIR=

# --- Workers -------------------------------------------------------------------
# Parallel verarbeitete Jobs (FFmpeg-lastig). 1 = strikt seriell. Default: 2
# CLIPFORGE_MAX_WORKERS=2

# --- Upload Limits -------------------------------------------------------------
# Max. Dateigröße pro Upload in MB. Default: 500
# CLIPFORGE_MAX_UPLOAD_MB=500
# Max. Anzahl Dateien pro Batch-Upload. Default: 10
# CLIPFORGE_MAX_BATCH_FILES=10

# --- Analyzer / Pipeline --------------------------------------------------------
# Lokales faster-whisper-Modell (tiny/base/small/medium/large-v3). Default: base
# CLIPFORGE_WHISPER_MODEL=base
# CLIPFORGE_WHISPER_DEVICE=cpu
# CLIPFORGE_WHISPER_COMPUTE=int8
# Clip-Länge (Sekunden): Min/Max/Ziel. Defaults: 15 / 60 / 30
# CLIPFORGE_MIN_CLIP_SECONDS=15.0
# CLIPFORGE_MAX_CLIP_SECONDS=60.0
# CLIPFORGE_TARGET_CLIP_SECONDS=30.0
# Pausen-Schwelle (Sekunden) für Clip-Trennung. Default: 0.6
# CLIPFORGE_SEGMENT_GAP=0.6
# Render-Ausgabegröße (9:16). Defaults: 1080x1920
# CLIPFORGE_OUT_WIDTH=1080
# CLIPFORGE_OUT_HEIGHT=1920
# Stille-Erkennung (Schnitte). Defaults: -30 dB / 0.6s
# CLIPFORGE_SILENCE_DB=-30.0
# CLIPFORGE_SILENCE_MIN=0.6

# --- LLM optional (Analyzer v2 KI-Modus) ---------------------------------------
# Ohne ANTHROPIC_API_KEY läuft der Analyzer regelbasiert (kein Fehler).
# CLIPFORGE_LLM_MODEL=claude-sonnet-4-6
# "auto" nutzt LLM nur, wenn ein Key gesetzt ist; "off" erzwingt regelbasiert.
# CLIPFORGE_USE_LLM=auto
# CLIPFORGE_LLM_TIMEOUT=30.0

# --- Brand Kit -------------------------------------------------------------------
# Pfad zur lokalen Brand-Kit-JSON. Default: api/config/brand_kit.json
# CLIPFORGE_BRAND_KIT=

# --- YouTube OAuth (Phase 2 — Readiness/Consent-URL, KEIN Upload) ---------------
# Feature-Flag für OAuth-Aktionen (Consent-URL vorbereiten). Default: false
# CLIPFORGE_ENABLE_YOUTUBE_OAUTH=false
# Pfad zu einer Google-OAuth-Client-Secrets-Datei (nur Existenzprüfung).
# CLIPFORGE_YOUTUBE_CLIENT_SECRETS=
# CLIPFORGE_YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/api/youtube/oauth/callback
# CLIPFORGE_YOUTUBE_OAUTH_STATE_TTL_SECONDS=600
# Keychain-Koordinaten (kein Token-Wert wird hier gespeichert).
# CLIPFORGE_YOUTUBE_TOKEN_SERVICE_NAME=clipforge-youtube
# CLIPFORGE_YOUTUBE_TOKEN_ACCOUNT=default

# --- YouTube Upload (Phase 3 — echter Upload, PRIVATE-only) ---------------------
# Feature-Flag für den echten, PRIVATEN Upload. Default: false.
# Bleibt aus, bis du bewusst testen willst — kein Public/Unlisted, kein TikTok/
# Instagram, kein automatischer Upload.
# CLIPFORGE_ENABLE_YOUTUBE_UPLOAD=false
# ZWEITES, unabhängiges Flag für den manuellen echten E2E-Testmodus. Nur
# zusätzlich zu obigem Flag wirksam. Default: false. Automatisierte Tests
# setzen dies NIE.
# CLIPFORGE_ENABLE_YOUTUBE_REAL_TEST=false
# CLIPFORGE_YOUTUBE_CATEGORY_ID=22
# CLIPFORGE_YOUTUBE_UPLOAD_MAX_ATTEMPTS=5
# CLIPFORGE_YOUTUBE_UPLOAD_INITIAL_DELAY=1.0
# CLIPFORGE_YOUTUBE_UPLOAD_MAX_DELAY=32.0
# CLIPFORGE_YOUTUBE_UPLOAD_CHUNK_BYTES=-1

# --- Recovery (Crash-Safe Startup-Scan) -----------------------------------------
# Erkennt verwaiste Upload-Zustände beim Start (sicher, lädt nie blind hoch).
# CLIPFORGE_YOUTUBE_RECOVERY_SCAN_ENABLED=true
# Ab wann ein aktiver Upload-Zustand als verwaist gilt (Sekunden). Default: 900
# CLIPFORGE_YOUTUBE_STALE_UPLOAD_SECONDS=900
# Timeout für einen Reconciliation-Remote-Check (Sekunden). Default: 60
# CLIPFORGE_YOUTUBE_RECONCILIATION_TIMEOUT_SECONDS=60
